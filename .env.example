# Copy to .env and fill in. .env is gitignored and must NEVER be committed.
# Nothing in this project requires credentials to run the default pipeline —
# all three sources are read from public, unauthenticated endpoints.

# --- Optional: override the Playwright browser profile location ---
# A persistent profile lets the browser keep cookies between runs, which
# reduces how often Cloudflare presents a challenge. It is NOT a login.
# INTERNSHIP_TRACKER_BROWSER_PROFILE=D:\School\Personal\Intership tracker\sessions\chrome

# --- Optional: path to the CV library used by `main.py profile --from-cv` ---
# INTERNSHIP_TRACKER_CV_LIBRARY=D:\Claude\CoWork\Projects\CV Optimizer\library

# --- Optional: path to the existing application tracker for `main.py apply` ---
# INTERNSHIP_TRACKER_APPLICATION_WORKBOOK=D:\Claude\CoWork\Projects\CV Optimizer\Job-Applications-Tracker.xlsx
# INTERNSHIP_TRACKER_APPLICATION_SCRIPT=D:\path\to\job-tracker\scripts\tracker.py

# --- Optional: override the daily run's verification budget ---
# INTERNSHIP_TRACKER_MAX_VERIFICATIONS=120
